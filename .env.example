APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# 仅在需要执行 20/50/100 章诊断验收时开启
GENERATION_ACCEPTANCE_TOOLS_ENABLED=false

# AI 请求日志开关：true 时记录完整请求载荷及 ai.models 映射；false 时不记录这些内容
AI_LOG_PROMPTS=false

# AI 模型路由的推荐环境回退值；管理后台“AI与成本 → 模型价格”保存路由后以数据库配置为准
# 均衡方案：章节规划、四个 Outline 任务和正文使用 Terra，审校使用 Sol，提取和摘要使用 Luna
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
AI_MODEL_PLANNER=gpt-5.6-terra
# 全书大纲 Provider 子任务必须逐项独立配置，缺失时禁止启动；不得回退章节规划路由
# 推理程度可填 low、medium、high；留空表示使用该 Provider 的默认行为
# 修改路由只影响新建或 Restart 批次；Resume 继续使用原批次冻结值
AI_PROVIDER_OUTLINE_FOUNDATION=openai
AI_MODEL_OUTLINE_FOUNDATION=gpt-5.6-terra
AI_REASONING_EFFORT_OUTLINE_FOUNDATION=low
AI_PROVIDER_OUTLINE_STRUCTURE=openai
AI_MODEL_OUTLINE_STRUCTURE=gpt-5.6-terra
AI_REASONING_EFFORT_OUTLINE_STRUCTURE=low
AI_PROVIDER_OUTLINE_ARC_BEATS=openai
AI_MODEL_OUTLINE_ARC_BEATS=gpt-5.6-terra
AI_REASONING_EFFORT_OUTLINE_ARC_BEATS=low
AI_PROVIDER_OUTLINE_BEAT_DETAIL=openai
AI_MODEL_OUTLINE_BEAT_DETAIL=gpt-5.6-terra
AI_REASONING_EFFORT_OUTLINE_BEAT_DETAIL=low
AI_MODEL_WRITER=gpt-5.6-terra
AI_MODEL_EXTRACTOR=gpt-5.6-luna
AI_MODEL_REVIEWER=gpt-5.6-sol
AI_MODEL_REWRITE=gpt-5.6-terra
AI_MODEL_SUMMARY=gpt-5.6-luna

# OpenAI 环境连接只作为后台未配置供应商连接时的回退；不要提交真实 API Key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CONNECT_TIMEOUT=10
OPENAI_TIMEOUT=300

# 其他 Stage 的推理程度保存在数据库模型路由中；Outline 同时提供上面的独立环境回退键
# 向量维度：必须与向量模型的输出维度及 memories.embedding 字段维度保持一致
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# AI 供应商连接、API Key、模型价格、模型路由和费用限额统一在管理后台“AI与成本”中维护

# 新建小说圣经时的默认目标平台，必须是 config/narrative.php platforms 中的 key
NARRATIVE_DEFAULT_TARGET_PLATFORM=fanqie

# 章节规划首次、第一次截断重试、最终截断重试的可见输出 Token 额度
PLANNER_MAX_OUTPUT_TOKENS=12000
PLANNER_RETRY_MAX_OUTPUT_TOKENS=16000
PLANNER_FINAL_RETRY_MAX_OUTPUT_TOKENS=24000
# 推理预留与可见输出额度相加后才是 Provider 实际完成预算；0 表示尚未预留，不代表模型不会推理
PLANNER_REASONING_RESERVE_TOKENS=0
# 推理耗尽只会选择推理预留严格增加的后续档；保持相同值时会直接终止，避免原参数重试
PLANNER_RETRY_REASONING_RESERVE_TOKENS=0
PLANNER_FINAL_RETRY_REASONING_RESERVE_TOKENS=0
# Outline 模型容量与结构化输出、推理程度能力在后台“模型价格”记录中维护
# 四个 Outline Provider 阶段分别配置可见结构化输出额度与推理 Token 预留；实际请求上限为两者之和
# 修改预算只影响新建或 Restart 批次；Resume 继续使用原批次冻结值
OUTLINE_FOUNDATION_OUTPUT_TOKENS=8000
OUTLINE_FOUNDATION_REASONING_RESERVE_TOKENS=4000
OUTLINE_STRUCTURE_OUTPUT_TOKENS=12000
OUTLINE_STRUCTURE_REASONING_RESERVE_TOKENS=4000
OUTLINE_ARC_BEATS_OUTPUT_TOKENS=8000
OUTLINE_ARC_BEATS_REASONING_RESERVE_TOKENS=4000
OUTLINE_BEAT_DETAIL_OUTPUT_TOKENS=5000
OUTLINE_BEAT_DETAIL_REASONING_RESERVE_TOKENS=3000
# 场景正文首次、第一次截断重试、最终截断重试的可见输出 Token 额度
SCENE_MAX_OUTPUT_TOKENS=12000
SCENE_RETRY_MAX_OUTPUT_TOKENS=16000
SCENE_FINAL_RETRY_MAX_OUTPUT_TOKENS=24000
SCENE_REASONING_RESERVE_TOKENS=0
SCENE_RETRY_REASONING_RESERVE_TOKENS=0
SCENE_FINAL_RETRY_REASONING_RESERVE_TOKENS=0
# 叙事审校当前固定使用一档可见输出额度；完成预算耗尽后不会用相同参数重试
REVIEW_MAX_OUTPUT_TOKENS=12000
REVIEW_REASONING_RESERVE_TOKENS=0
# 事件提取首次、第一次截断重试、最终截断重试的可见输出 Token 额度
EVENT_EXTRACTION_MAX_OUTPUT_TOKENS=4000
EVENT_EXTRACTION_RETRY_MAX_OUTPUT_TOKENS=8000
EVENT_EXTRACTION_FINAL_RETRY_MAX_OUTPUT_TOKENS=12000
EVENT_EXTRACTION_REASONING_RESERVE_TOKENS=0
EVENT_EXTRACTION_RETRY_REASONING_RESERVE_TOKENS=0
EVENT_EXTRACTION_FINAL_RETRY_REASONING_RESERVE_TOKENS=0
# Rewrite 首次、第一次截断重试、最终截断重试的可见输出 Token 额度
REWRITE_MAX_OUTPUT_TOKENS=16000
REWRITE_RETRY_MAX_OUTPUT_TOKENS=20000
REWRITE_FINAL_RETRY_MAX_OUTPUT_TOKENS=24000
REWRITE_REASONING_RESERVE_TOKENS=0
REWRITE_RETRY_REASONING_RESERVE_TOKENS=0
REWRITE_FINAL_RETRY_REASONING_RESERVE_TOKENS=0
# Canonical Summary 首次、第一次截断重试、最终截断重试的可见输出 Token 额度
SUMMARY_MAX_OUTPUT_TOKENS=1200
SUMMARY_RETRY_MAX_OUTPUT_TOKENS=2400
SUMMARY_FINAL_RETRY_MAX_OUTPUT_TOKENS=4000
SUMMARY_REASONING_RESERVE_TOKENS=0
SUMMARY_RETRY_REASONING_RESERVE_TOKENS=0
SUMMARY_FINAL_RETRY_REASONING_RESERVE_TOKENS=0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
HORIZON_WORKER_TIMEOUT=360
REDIS_QUEUE_RETRY_AFTER=420
STALLED_RUN_AFTER_SECONDS=480
GENERATION_PENDING_JOB_SECONDS=900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
