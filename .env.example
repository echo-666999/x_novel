APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

AI_PROVIDER=openai
AI_LOG_PROMPTS=false
# Blank stage overrides inherit AI_MODEL. Verify availability on the selected Provider.
AI_MODEL=gpt-5.6-luna
AI_MODEL_PLANNER=
AI_MODEL_WRITER=
AI_MODEL_ASSEMBLER=
AI_MODEL_EXTRACTOR=
AI_MODEL_REVIEWER=
AI_MODEL_REWRITE=
AI_MODEL_SUMMARY=
AI_MODEL_EMBEDDING=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
# Provider Base URL, API Key, Timeout, token pricing and budgets are maintained
# in Settings and stored in system_settings.ai. Existing environment values
# remain supported as a compatibility fallback but are not required here.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
HORIZON_WORKER_TIMEOUT=210
REDIS_QUEUE_RETRY_AFTER=240
STALLED_RUN_AFTER_SECONDS=300
GENERATION_PENDING_JOB_SECONDS=900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
