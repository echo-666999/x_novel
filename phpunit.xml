<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="AI_PROVIDER_OUTLINE_FOUNDATION" value="openai"/>
        <env name="AI_MODEL_OUTLINE_FOUNDATION" value="gpt-5.6-terra"/>
        <env name="AI_REASONING_EFFORT_OUTLINE_FOUNDATION" value=""/>
        <env name="AI_PROVIDER_OUTLINE_STRUCTURE" value="openai"/>
        <env name="AI_MODEL_OUTLINE_STRUCTURE" value="gpt-5.6-terra"/>
        <env name="AI_REASONING_EFFORT_OUTLINE_STRUCTURE" value=""/>
        <env name="AI_PROVIDER_OUTLINE_ARC_BEATS" value="openai"/>
        <env name="AI_MODEL_OUTLINE_ARC_BEATS" value="gpt-5.6-terra"/>
        <env name="AI_REASONING_EFFORT_OUTLINE_ARC_BEATS" value=""/>
        <env name="AI_PROVIDER_OUTLINE_BEAT_DETAIL" value="openai"/>
        <env name="AI_MODEL_OUTLINE_BEAT_DETAIL" value="gpt-5.6-terra"/>
        <env name="AI_REASONING_EFFORT_OUTLINE_BEAT_DETAIL" value=""/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
